{
  "manifest_version": 3,
  "name": "Video2Team · 方舟作业适配器",
  "version": "0.2.0",
  "description": "把大佬的作业，改成你抄得动的作业 — B站明日方舟挂机攻略阵容适配",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://comment.bilibili.com/*",
    "https://chat.deepseek.com/*",
    "https://api.deepseek.com/*",
    "https://api.siliconflow.cn/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://cdn.jsdelivr.net/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video2Team · 方舟作业适配器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content-deepseek.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}